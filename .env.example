# Sentry crash reporting (optional but recommended for beta)
# Create a project at sentry.io (free), copy the DSN from Project Settings → Client Keys
EXPO_PUBLIC_SENTRY_DSN=https://your-key@oXXXXXX.ingest.sentry.io/XXXXXXX

# Supabase credentials
# Get these from: Supabase Dashboard → Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Google Maps API Key (required for road-based distance calculation in POI creator)
# Get your API key from: https://console.cloud.google.com/google/maps-apis
# Enable the Directions API for your project
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your_api_key_here

# OpenWeatherMap API key (required for weather widget)
# Get your API key from: https://openweathermap.org/api
EXPO_PUBLIC_OPENWEATHER_API_KEY=your_api_key_here

# ─── AI Insights Provider ─────────────────────────────────────────────────────
#
# Choose your AI provider for driving insights:
#
# OPTION 1: Groq (RECOMMENDED for production — FREE tier, 1M tokens/day)
#   Sign up at https://console.groq.com — no credit card needed
#   Fast (~500ms), uses llama-3.1-8b-instant model
#
# OPTION 2: Ollama (local Mac — dev only, home network only)
#   Install: brew install ollama && ollama pull llama3.2:3b && ollama serve
#   Set OLLAMA_URL to your Mac's LAN IP: http://192.168.x.x:11434
#
# OPTION 3: Anthropic Claude (premium quality, paid)
#   Get key from: https://console.anthropic.com
#   NOTE: For production, proxy through a Supabase Edge Function
#
# If no key is set, the app uses built-in rule-based insights (always works, no API needed)
#
EXPO_PUBLIC_AI_PROVIDER=groq  # groq | anthropic | ollama | local

# Groq (free tier — recommended)
EXPO_PUBLIC_GROQ_API_KEY=your_groq_key_here

# Anthropic Claude (paid)
EXPO_PUBLIC_ANTHROPIC_API_KEY=your_anthropic_key_here

# Ollama (local Mac on your LAN — dev only)
EXPO_PUBLIC_OLLAMA_URL=http://192.168.1.x:11434
EXPO_PUBLIC_OLLAMA_MODEL=llama3.2:3b
